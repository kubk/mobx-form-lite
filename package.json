{
  "name": "mobx-form-lite",
  "version": "0.10.0",
  "packageManager": "pnpm@9.15.0",
  "description": "",
  "source": "src/index.ts",
  "main": "dist/mobx-form-lite.js",
  "module": "dist/mobx-form-lite.module.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "microbundle",
    "dev": "microbundle watch",
    "format": "oxfmt \"src/**/*.{ts,tsx}\" README.md \"docs/**/*.md\" \"docs/snippets/**/*.{ts,tsx}\" \"playground/src/examples/antd-dynamic-form-ex/**/*.{ts,tsx}\"",
    "test": "vitest --dir=src --typecheck",
    "test:coverage": "vitest run --dir=src/ --coverage",
    "test:size": "size-limit",
    "prettier": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "pnpm run playground:build && vitepress dev docs",
    "docs:build": "pnpm run playground:build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "playground:build": "pnpm run build && pnpm --filter playground run build:docs",
    "release": "sh -c 'npm version --message \"Release %s\" \"$0\" && git push --follow-tags'"
  },
  "size-limit": [
    {
      "path": "dist/mobx-form-lite.modern.mjs",
      "limit": "1.1 kB"
    }
  ],
  "keywords": [
    "mobx",
    "form",
    "form management",
    "mobx form"
  ],
  "files": [
    "dist"
  ],
  "author": "https://github.com/kubk",
  "license": "MIT",
  "devDependencies": {
    "@babel/plugin-transform-typescript": "^7.29.0",
    "@size-limit/preset-small-lib": "^11.0.2",
    "@vitest/coverage-v8": "^3.0.8",
    "microbundle": "^0.15.1",
    "mobx": "^7.1.6",
    "oxfmt": "^0.59.0",
    "prettier": "^3.2.5",
    "size-limit": "^11.0.2",
    "typescript": "^5.8.2",
    "vitepress": "^1.0.0-rc.45",
    "vitest": "^3.0.8"
  },
  "peerDependencies": {
    "mobx": ">=7.0.0"
  }
}
